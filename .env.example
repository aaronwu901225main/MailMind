# Keep .env private; never upload secrets to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 留白表示使用 data/mailmind.db
DATABASE_URL=

MAX_DAILY_SUMMARIES=10
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

MAILMIND_LINE_CHANNEL_SECRET=
MAILMIND_LINE_CHANNEL_ACCESS_TOKEN=
MAX_LINE_PUSHES_PER_MONTH=
MAILMIND_MCP_ACCOUNT_ID=

MAILMIND_AGENT_ENABLED=true
MAILMIND_AGENT_ALLOW_CLOUD_EMAIL=true

MAILMIND_AGENT_USE_SEMANTIC=false

MAILMIND_AGENT_DAILY_LIMIT=50
MAILMIND_AGENT_MONTHLY_PUSH_LIMIT=200
MAILMIND_AGENT_MAX_QUEUE=200