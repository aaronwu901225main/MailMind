/** MailMind v0.2: one Apps Script project per Gmail account.
 *  Required Script Properties:
 *  BACKEND_URL = https://<your-https-host> (NO trailing slash)
 *  ACCOUNT_ID = generated by scripts.create_account
 *  INGEST_TOKEN = generated by scripts.create_account
 */
const MM_LOOKBACK_QUERY = 'in:inbox newer_than:2d';
const MM_THREAD_LIMIT = 80;
const MM_CACHE_LIMIT = 250;
const MM_ATTACHMENT_MAX_COUNT = 3;
const MM_ATTACHMENT_MAX_BYTES = 2 * 1024 * 1024;
const MM_ATTACHMENTS_TOTAL_BYTES = 4 * 1024 * 1024;

/** Only send supported attachment types; never send inline tracking pixels. */
function mmAttachments_(message) {
  const supported = /\.(pdf|docx|png|jpg|jpeg)$/i;
  const attachments = [];
  const notes = [];
  let total = 0;
  for (const item of message.getAttachments({includeInlineImages: false, includeAttachments: true})) {
    const name = (item.getName() || 'attachment').slice(0, 160);
    const size = item.getSize();
    if (!supported.test(name)) {
      notes.push(name + '：格式未支援');
      continue;
    }
    if (size > MM_ATTACHMENT_MAX_BYTES || total + size > MM_ATTACHMENTS_TOTAL_BYTES ||
        attachments.length >= MM_ATTACHMENT_MAX_COUNT) {
      notes.push(name + '：超過大小或數量限制');
      continue;
    }
    attachments.push({
      filename: name,
      mime_type: item.getContentType() || 'application/octet-stream',
      data_base64: Utilities.base64Encode(item.getBytes())
    });
    total += size;
  }
  return {attachments: attachments, attachment_notes: notes.join('；').slice(0, 800)};
} 

function mmConfig_() {
  const props = PropertiesService.getScriptProperties();
  const backend = props.getProperty('BACKEND_URL');
  const accountId = props.getProperty('ACCOUNT_ID');
  const token = props.getProperty('INGEST_TOKEN');
  if (!backend || !accountId || !token) {
    throw new Error('Missing BACKEND_URL, ACCOUNT_ID, or INGEST_TOKEN in Script Properties');
  }
  if (!/^https:\/\//.test(backend)) {
    throw new Error('BACKEND_URL must use HTTPS');
  }
  return { props, backend: backend.replace(/\/$/, ''), accountId, token };
}

function mmPost_(cfg, mail) {
  const response = UrlFetchApp.fetch(cfg.backend + '/api/v1/ingest/gmail', {
    method: 'post',
    contentType: 'application/json',
    headers: { 'X-MailMind-Token': cfg.token },
    payload: JSON.stringify(mail),
    muteHttpExceptions: true,
    followRedirects: false
  });
  const code = response.getResponseCode();
  if (code < 200 || code >= 300) {
    throw new Error('Backend HTTP ' + code + ': ' + response.getContentText().slice(0, 180));
  }
  return JSON.parse(response.getContentText());
}

/** Run once before the first real inbox scan to avoid importing older mail. */
function mmInitialize() {
  const cfg = mmConfig_();
  if (cfg.props.getProperty('START_AT_ISO')) {
    console.log('Already initialized; existing start time retained.');
    return;
  }
  cfg.props.setProperty('START_AT_ISO', new Date().toISOString());
  console.log('Ready. New mail arriving after this timestamp will be processed.');
}

/** Run manually to test the full backend without sending a private Gmail. */
function mmSendDemo() {
  const cfg = mmConfig_();
  const result = mmPost_(cfg, {
    account_id: cfg.accountId,
    message_id: 'apps-script-demo-v02',
    sender: 'demo@example.com',
    subject: 'MailMind Apps Script 測試',
    body: '這是虛構信件，請在 2026/10/18 18:00 前繳交報告。'
  });
  console.log('Demo result: ' + result.status);
}

/** Trigger runs every 5 minutes; successful IDs are cached to reduce requests. */
function mmScanInbox() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return;
  try {
    const cfg = mmConfig_();
    const startISO = cfg.props.getProperty('START_AT_ISO');
    if (!startISO) throw new Error('Run mmInitialize before scanning!');
    const startMs = new Date(startISO).getTime();
    const cache = JSON.parse(cfg.props.getProperty('SUCCESS_IDS') || '[]');
    const seen = new Set(cache);
    const messages = [];
    const threads = GmailApp.search(MM_LOOKBACK_QUERY, 0, MM_THREAD_LIMIT);
    for (const thread of threads) {
      for (const msg of thread.getMessages()) {
        if (msg.getDate().getTime() >= startMs && !seen.has(msg.getId())) {
          messages.push(msg);
        }
      }
    }
    messages.sort((a, b) => a.getDate() - b.getDate());
    for (const msg of messages) {
      try {
        const response = mmPost_(cfg, {
          account_id: cfg.accountId,
          message_id: msg.getId(),
          sender: msg.getFrom().slice(0, 320),
          subject: msg.getSubject().slice(0, 500),
          body: msg.getPlainBody().slice(0, 12000),
          ...mmAttachments_(msg)
        });
        if (response.status === 'completed' || response.status === 'duplicate') {
          cache.push(msg.getId());
          seen.add(msg.getId());
          if (cache.length > MM_CACHE_LIMIT) cache.splice(0, cache.length - MM_CACHE_LIMIT);
          cfg.props.setProperty('SUCCESS_IDS', JSON.stringify(cache));
          console.log('Mail accepted: ' + msg.getId());
        }
      } catch (err) {
        console.error('Ingest failed for message ' + msg.getId() + ': ' + err.message);
        // Keep failed IDs uncached: later runs will retry.
      }
    }
  } finally {
    lock.releaseLock();
  }
}

/** Enable only after manual tests pass. Safe to call repeatedly. */
function mmInstallTrigger() {
  mmConfig_();
  const existing = ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'mmScanInbox');
  if (!existing) {
    ScriptApp.newTrigger('mmScanInbox').timeBased().everyMinutes(5).create();
  }
  console.log('MailMind time-driven trigger installed (every 5 minutes).');
}

function mmRemoveTrigger() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'mmScanInbox')
    .forEach(t => ScriptApp.deleteTrigger(t));
  console.log('MailMind trigger removed.');
}
